    "max_stepper_source_response_weighted_L1": 0.005,
    "max_stepper_source_response_moment_relerr_k0_through_k5": 0.005,
    "max_stepper_h_over_h2_weighted_L1_and_moment_relerr": 0.005,
    "max_abs_decay_weighted_Born_capture_proxy_relerr": 0.005,
    "endpoint_coverage_through_t_over_tau_18": true,
